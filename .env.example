# EduPay Waitlist Admin — environment template.
# Copy to .env.local for local development. Never commit real values.
# This file contains variable NAMES and safe placeholders only.
#
# RULE: owner UUIDs, staff session secrets, service-role keys, mail provider
# keys, private keys and authentication tokens must NEVER be placed in this
# frontend project. They belong in the backend's server-side configuration.

# Server-side base URL of the existing EduPay backend that will expose the
# owner-protected waitlist admin API. Reserved for Phase 5 — the final variable
# name and endpoint contract MUST be confirmed against the backend repository
# before any integration is written. Placeholder only, not a real host.
EDUPAY_API_BASE_URL=https://backend.example.invalid

# Build-time data mode. "demo" (the safe default) keeps the clearly labelled
# sample UI and never attempts a backend call. "live" does NOT invent data: it
# renders an honest "backend not connected" state until the verified API client
# is implemented. Any other value falls back to "demo".
NEXT_PUBLIC_DATA_MODE=demo

# Public origin of this admin app (metadata, redirects, canonical URLs).
# Placeholder only. The proposed production origin is
# https://waitlist-admin.edupayafrica.com.ng — do NOT change DNS or deploy yet.
NEXT_PUBLIC_SITE_URL=https://waitlist-admin.example.invalid
